{
  "name": "Meesho Hisab",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup python run_portal.py > /tmp/portal.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Meesho Hisab portal", "onAutoForward": "openPreview" }
  }
}
